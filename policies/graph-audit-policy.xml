<!--
    Microsoft Graph 게이트웨이 — 감사(audit) 강화 정책  [AFTER]
    ────────────────────────────────────────────────────────────
    적용 위치: APIM → APIs → "Microsoft Graph" → All operations → Inbound/Outbound

    Lab 11의 기존 정책(인증 + 403 게이트)에 "감사 로깅"을 더한 버전입니다.
    이 정책이 추가로 남기는 것(현재 로깅에는 없는 것):
      1) 요청 레그 trace  → App Insights `traces` + GatewayLogs `TraceRecords` 컬럼을 채움
      2) 완료 레그 감사레코드 → Event Hub 로 구조화 JSON(호출자/입력/Graph호출/결과) 무손실 전송
      3) "어떤 정체성으로 Graph를 호출했는가"(System MI vs UAMI client-id)를 명시적으로 기록
      4) 정책 게이트의 차단 사유(deny reason)를 규칙 단위로 기록
      5) 비밀(구독 키/Bearer)을 원문으로 남기지 않고 마스킹/해시로 대체

    전제:
      - Event Hub logger `graph-audit-eventhub` 가 APIM 에 등록되어 있어야 합니다.
        (미등록 시 <log-to-eventhub> 는 no-op 이 아니라 오류가 되므로, 아래 배포 스니펫 참고)
      - 정책 표현식의 특수문자는 XML 엔티티로 이스케이프합니다: " → &quot;, && → &amp;&amp;, < → &lt;

    ⚠️ App Insights `traces` 가 0건이면 (실측으로 확인된 함정):
      - trace 는 "정책 severity ≥ 진단 verbosity" 일 때만 App Insights 에 남습니다.
        진단 verbosity 기본값은 사실상 error → severity="information" trace 가 전부 드롭됩니다.
        해결: 이 API(또는 서비스)의 Application Insights 진단 verbosity 를 information/verbose 로 설정.
      - APIM 설정 전파에 ~1~2분 걸립니다. verbosity·정책 변경 직후 곧바로 호출하면 누락되니,
        변경 후 잠시(약 2분) 기다린 뒤 트래픽을 보내세요.
      - `Ocp-Apim-Trace` 헤더/구독 트레이싱은 더 이상 지원되지 않습니다(진단 verbosity 가 유일한 스위치).
      - 자세한 규명 타임라인·체크리스트: docs/graph-gateway-audit-logging.md 부록 C.
-->
<policies>
    <inbound>
        <base />

        <!-- ── 1) 감사 컨텍스트 추출 (입력을 구조화해 변수에 보관) ── -->
        <!-- 대상 사용자 ID: GET /users/{user-id}/... 템플릿 파라미터 -->
        <set-variable name="auditTargetUser" value="@(context.Request.MatchedParameters.ContainsKey(&quot;user-id&quot;) ? context.Request.MatchedParameters[&quot;user-id&quot;] : &quot;-&quot;)" />
        <!-- OData 질의: 무엇을 select/filter 했는가 = "무슨 데이터를 가져갔나"의 핵심 -->
        <!-- OriginalUrl.Query 는 IReadOnlyDictionary<string,string[]> 이므로 ContainsKey + string.Join 으로 안전 추출 -->
        <set-variable name="auditSelect" value="@(context.Request.OriginalUrl.Query.ContainsKey(&quot;$select&quot;) ? string.Join(&quot;,&quot;, context.Request.OriginalUrl.Query[&quot;$select&quot;]) : &quot;-&quot;)" />
        <set-variable name="auditFilter" value="@(context.Request.OriginalUrl.Query.ContainsKey(&quot;$filter&quot;) ? string.Join(&quot;,&quot;, context.Request.OriginalUrl.Query[&quot;$filter&quot;]) : &quot;-&quot;)" />
        <!-- 비밀은 원문 대신 지문(fingerprint)만: 구독 키 앞 3글자만 남기고 나머지 마스킹 -->
        <set-variable name="auditKeyHint" value="@{
            var k = context.Request.Headers.GetValueOrDefault(&quot;Ocp-Apim-Subscription-Key&quot;, &quot;&quot;);
            return string.IsNullOrEmpty(k) ? &quot;-&quot; : (k.Substring(0, System.Math.Min(3, k.Length)) + &quot;***&quot;);
        }" />
        <!-- 어떤 정체성으로 Graph를 부를지 기본값(System MI). Part 2(UAMI) 라우팅 시 각 when에서 덮어씀 -->
        <set-variable name="auditIdentity" value="system-assigned" />

        <!-- ── 2) (기존) 구독(Product)별 Operation 게이트 — 차단 사유를 변수로 기록 ── -->
        <choose>
            <when condition="@(context.Product?.Name == &quot;graph-users&quot; &amp;&amp; context.Operation.UrlTemplate.Contains(&quot;/messages&quot;))">
                <set-variable name="auditDeny" value="graph-users는 메일 조회 불가" />
                <return-response>
                    <set-status code="403" reason="Forbidden" />
                    <set-body>이 구독(graph-users)은 사용자 조회만 허용됩니다.</set-body>
                </return-response>
            </when>
            <when condition="@(context.Product?.Name == &quot;graph-mail&quot; &amp;&amp; !context.Operation.UrlTemplate.Contains(&quot;/messages&quot;))">
                <set-variable name="auditDeny" value="graph-mail은 메일 조회만 허용" />
                <return-response>
                    <set-status code="403" reason="Forbidden" />
                    <set-body>이 구독(graph-mail)은 메일 조회만 허용됩니다.</set-body>
                </return-response>
            </when>
            <when condition="@(context.Product?.Name == &quot;graph-sharepoint&quot; &amp;&amp; !context.Operation.UrlTemplate.Contains(&quot;/sites&quot;))">
                <set-variable name="auditDeny" value="graph-sharepoint은 SharePoint 조회만 허용" />
                <return-response>
                    <set-status code="403" reason="Forbidden" />
                    <set-body>이 구독(graph-sharepoint)은 SharePoint 조회만 허용됩니다.</set-body>
                </return-response>
            </when>
            <when condition="@(context.Product?.Name == &quot;graph-users&quot; &amp;&amp; context.Operation.UrlTemplate.Contains(&quot;/sites&quot;))">
                <set-variable name="auditDeny" value="graph-users는 SharePoint 조회 권한 없음" />
                <return-response>
                    <set-status code="403" reason="Forbidden" />
                    <set-body>이 구독(graph-users)은 SharePoint 조회 권한이 없습니다.</set-body>
                </return-response>
            </when>
        </choose>

        <!-- ── 3) System MI로 Graph 토큰 발급 (옵션 A) ──
             옵션 B(권한별 UAMI)로 전환할 경우, 위 authentication을 아래처럼 client-id 라우팅으로
             교체하고 각 분기에서 <set-variable name="auditIdentity" value="uami-graph-mail"/> 식으로
             "실제 발급 정체성"을 감사에 남깁니다. -->
        <authentication-managed-identity resource="https://graph.microsoft.com" />

        <!-- ── 4) 요청 레그 감사 trace ──
             App Insights `traces` 로 남고, GatewayLogs 의 `TraceRecords` 컬럼에도 채워집니다.
             (severity >= 진단설정 verbosity(information) 여야 수집됨) -->
        <trace source="graph-audit" severity="information">
            <message>@($"GRAPH-AUDIT-REQ op={context.Operation.Name} path={context.Request.OriginalUrl.Path}")</message>
            <metadata name="product" value="@(context.Product?.Name ?? &quot;-&quot;)" />
            <metadata name="subscriptionId" value="@(context.Subscription?.Id ?? &quot;-&quot;)" />
            <metadata name="subscriptionName" value="@(context.Subscription?.Name ?? &quot;-&quot;)" />
            <metadata name="callerIp" value="@(context.Request.IpAddress)" />
            <metadata name="keyHint" value="@((string)context.Variables[&quot;auditKeyHint&quot;])" />
            <metadata name="targetUser" value="@((string)context.Variables[&quot;auditTargetUser&quot;])" />
            <metadata name="select" value="@((string)context.Variables[&quot;auditSelect&quot;])" />
            <metadata name="filter" value="@((string)context.Variables[&quot;auditFilter&quot;])" />
            <metadata name="graphIdentity" value="@((string)context.Variables[&quot;auditIdentity&quot;])" />
        </trace>
    </inbound>

    <backend>
        <base />
    </backend>

    <outbound>
        <base />

        <!-- ── 5) 완료 레그 감사 레코드 → Event Hub (구조화 JSON, 무손실) ──
             App Insights body 4~8KB 상한과 무관하게, "감사에 필요한 필드"만 정확히 남깁니다.
             비밀(키/Bearer)은 넣지 않고, 마스킹된 keyHint 만 포함합니다. -->
        <log-to-eventhub logger-id="graph-audit-eventhub">@{
            return new JObject(
                new JProperty("ts", DateTime.UtcNow.ToString("o")),
                new JProperty("correlationId", context.RequestId),
                new JProperty("caller", new JObject(
                    new JProperty("product", context.Product?.Name ?? "-"),
                    new JProperty("subscriptionId", context.Subscription?.Id ?? "-"),
                    new JProperty("subscriptionName", context.Subscription?.Name ?? "-"),
                    new JProperty("keyHint", (string)context.Variables.GetValueOrDefault("auditKeyHint", "-")),
                    new JProperty("callerIp", context.Request.IpAddress),
                    new JProperty("xff", context.Request.Headers.GetValueOrDefault("X-Forwarded-For", "-"))
                )),
                new JProperty("request", new JObject(
                    new JProperty("method", context.Request.Method),
                    new JProperty("operation", context.Operation.Name),
                    new JProperty("clientUrl", context.Request.OriginalUrl.ToString()),
                    new JProperty("targetUser", (string)context.Variables.GetValueOrDefault("auditTargetUser", "-")),
                    new JProperty("select", (string)context.Variables.GetValueOrDefault("auditSelect", "-")),
                    new JProperty("filter", (string)context.Variables.GetValueOrDefault("auditFilter", "-"))
                )),
                new JProperty("graphCall", new JObject(
                    new JProperty("identity", (string)context.Variables.GetValueOrDefault("auditIdentity", "-")),
                    new JProperty("graphUrl", context.Request.Url.ToString()),
                    new JProperty("graphHost", context.Request.Url.Host)
                )),
                new JProperty("response", new JObject(
                    new JProperty("status", context.Response.StatusCode),
                    new JProperty("outcome", context.Response.StatusCode >= 400 ? "deny" : "allow"),
                    new JProperty("denyReason", (string)context.Variables.GetValueOrDefault("auditDeny", "-")),
                    new JProperty("latencyMs", context.Elapsed.TotalMilliseconds),
                    new JProperty("size", context.Response.Headers.GetValueOrDefault("Content-Length", "-"))
                ))
            ).ToString();
        }</log-to-eventhub>
    </outbound>

    <on-error>
        <base />
        <!-- 실패도 감사 대상: on-error 에서도 동일 레코드를 남겨 "차단/오류" 흐름을 놓치지 않습니다. -->
        <log-to-eventhub logger-id="graph-audit-eventhub">@{
            return new JObject(
                new JProperty("ts", DateTime.UtcNow.ToString("o")),
                new JProperty("correlationId", context.RequestId),
                new JProperty("phase", "on-error"),
                new JProperty("product", context.Product?.Name ?? "-"),
                new JProperty("subscriptionId", context.Subscription?.Id ?? "-"),
                new JProperty("clientUrl", context.Request.OriginalUrl.ToString()),
                new JProperty("targetUser", (string)context.Variables.GetValueOrDefault("auditTargetUser", "-")),
                new JProperty("status", context.Response.StatusCode),
                new JProperty("denyReason", (string)context.Variables.GetValueOrDefault("auditDeny", "-")),
                new JProperty("lastError", context.LastError?.Message ?? "-")
            ).ToString();
        }</log-to-eventhub>
    </on-error>
</policies>
