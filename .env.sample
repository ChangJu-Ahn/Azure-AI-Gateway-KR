# ─── AI Gateway Lab 환경 변수 ───
# deploy.sh 실행 시 이 .env.sample 을 .env 로 복사하고 아래 [자동] 항목을 실제 배포 값으로 채웁니다.
#
# 범례:
#   [자동]   deploy.sh 가 최초 배포 시 실제 값으로 자동 입력 → 보통 손댈 필요 없음
#            (대상: APIM_URL / APIM_NAME / RESOURCE_GROUP — 이 3개뿐)
#   [수동]   사용자가 직접 입력해야 하는 값 (키·시크릿·App ID 등). 해당 Lab 을 할 때 채우면 됨
#   [기본값] 기본값이 이미 채워져 있음 — 다른 모델/API 를 쓸 때만 변경
#
# ⚠️ setup-monitoring.sh 등 다른 스크립트는 .env 를 자동으로 채우지 않습니다(=[자동] 아님).

# ═══════════════════════════════════════════════════════
# 필수 설정 (Lab 1~6 공통)
# ═══════════════════════════════════════════════════════

# APIM 설정 — [자동] deploy.sh 가 배포 결과로 자동 입력 (아래 3개)
#   자동 입력 실패 시에만 아래 경로로 수동 확인하세요.
# 확인: Azure Portal → API Management → Overview → Gateway URL
APIM_URL=https://<apim-name>.azure-api.net
# 확인: Azure Portal → API Management → Overview → Name
APIM_NAME=<apim-name>
# 확인: Azure Portal → 리소스 그룹 이름
RESOURCE_GROUP=rg-ai-gw-<suffix>

# APIM Subscription Key — [수동] 직접 입력 필요
# 경로: Azure Portal → API Management → APIs → Subscriptions
#       → Built-in all-access subscription → ··· → Show/hide keys → Primary key 복사
APIM_SUBSCRIPTION_KEY="<your-subscription-key>"

# API 설정 — [기본값] 기본 모델/API. 다른 걸 쓸 때만 변경
# DEPLOYMENT_NAME: Azure OpenAI에 배포된 모델 이름 (infra/modules/openai.bicep 참고)
DEPLOYMENT_NAME=gpt-4.1-nano
# APIM_API_NAME: APIM에 등록한 API 이름 (Portal → APIM → APIs에서 확인)
APIM_API_NAME=azure-openai

# ═══════════════════════════════════════════════════════
# Lab 4: 멀티 테넌트 테스트용 (선택사항) — [수동]
# ═══════════════════════════════════════════════════════

# test-token-limit.ipynb의 1단계 셀 실행 시 자동 생성되어 출력됩니다.
# 출력된 Primary Key를 아래에 입력하세요.
# 수동 확인: Azure Portal → APIM → APIs → Subscriptions
#            → Sub: Request Limited / Sub: Token Limited → Show/hide keys
APIM_KEY_REQUEST_LIMITED="<your-request-limited-key>"
APIM_KEY_TOKEN_LIMITED="<your-token-limited-key>"

# ═══════════════════════════════════════════════════════
# Lab 4: Azure AD JWT 테스트용 (선택사항) — [수동]
# ═══════════════════════════════════════════════════════

# JWT 인증 실습을 하려면 Azure AD에 앱을 등록해야 합니다.
# 경로: Azure Portal → Microsoft Entra ID (구 Azure AD) → 앱 등록
#       → + 새 등록 → 등록 후 아래 값 확인
# AZURE_TENANT_ID: 개요 → 디렉터리(테넌트) ID
# AZURE_CLIENT_ID: 개요 → 애플리케이션(클라이언트) ID
# AZURE_CLIENT_SECRET: 인증서 및 비밀 → + 새 클라이언트 비밀 → 값 복사
AZURE_TENANT_ID="<your-tenant-id>"
AZURE_CLIENT_ID="<your-client-id>"
AZURE_CLIENT_SECRET="<your-client-secret>"

# ═══════════════════════════════════════════════════════
# Lab 5: Gemini 설정 (선택사항) — [수동]
# ═══════════════════════════════════════════════════════

# Google AI Studio에서 API Key를 발급받으세요.
# 경로: https://aistudio.google.com/apikey → Create API key
# 3개 키를 로드밸런싱에 사용합니다
GEMINI_API_KEY_1="<your-gemini-api-key-1>"
GEMINI_API_KEY_2="<your-gemini-api-key-2>"
GEMINI_API_KEY_3="<your-gemini-api-key-3>"

# ═══════════════════════════════════════════════════════
# Lab 6: App Insights 쿼리용 (선택사항) — [수동]
# ═══════════════════════════════════════════════════════

# 노트북에서 KQL을 프로그래밍 방식으로 조회할 때 사용합니다.
# Portal에서 직접 KQL을 실행한다면 이 설정 없이도 Lab 6 진행 가능합니다.
#
# 인증: Azure CLI 토큰을 사용하므로 API Key는 필요 없습니다 (az login만 되어 있으면 됨)
# APP_INSIGHTS_APP_ID만 설정하세요.
#
# 경로: Azure Portal → Application Insights → Configure → API Access → Application ID 복사
#
# ⚠️ 값은 반드시 Application ID(GUID) 하나만 넣으세요 (예: 0aea0792-937a-4daf-bfd8-05ebbfc72fef).
#    Overview 의 "Instrumentation Key" 나 "Connection string"(InstrumentationKey=...;...) 전체를
#    넣으면 KQL 조회가 실패합니다.
# 💡 비워두거나 <...> 플레이스홀더로 두면 Lab 9/10 노트북이 리소스 그룹에서 자동 탐색합니다.
APP_INSIGHTS_APP_ID="<your-app-insights-app-id>"

# ═══════════════════════════════════════════════════════
# Lab 8: 멀티 클라우드 프로바이더 (선택사항) — [수동]
# ═══════════════════════════════════════════════════════

# OpenAI 직접 — https://platform.openai.com/api-keys
OPENAI_API_KEY="<your-openai-api-key>"

# Anthropic 직접 — https://console.anthropic.com/settings/keys
# 3개 키를 로드밸런싱에 사용합니다 (Gemini 와 동일 패턴)
ANTHROPIC_API_KEY_1="<your-anthropic-api-key-1>"
ANTHROPIC_API_KEY_2="<your-anthropic-api-key-2>"
ANTHROPIC_API_KEY_3="<your-anthropic-api-key-3>"

# ═══════════════════════════════════════════════════════
# Lab 11: Graph Managed Identity (선택사항) — [수동]
# ═══════════════════════════════════════════════════════

# APIM Products(graph-users / graph-mail)에서 발급한 구독 키.
# 경로: Azure Portal → APIM → Products → graph-users / graph-mail
#       → Subscriptions → Show/hide keys → Primary key 복사
APIM_KEY_GRAPH_USERS="<your-graph-users-subscription-key>"
APIM_KEY_GRAPH_MAIL="<your-graph-mail-subscription-key>"
APIM_KEY_GRAPH_SHAREPOINT="<your-graph-sharepoint-subscription-key>"

# (선택) 테스트에 사용할 특정 사용자 objectId. 비우면 노트북이 첫 사용자를 자동 사용합니다.
GRAPH_TEST_USER_ID="<optional-user-object-id>"

# SharePoint 사이트 위치 (Part 1 SharePoint 시나리오용).
# 예: 사이트 URL이 https://contoso.sharepoint.com/sites/TeamSite 이면
#     SHAREPOINT_SITE_HOSTNAME=contoso.sharepoint.com, SHAREPOINT_SITE_PATH=TeamSite
SHAREPOINT_SITE_HOSTNAME="<your-tenant.sharepoint.com>"
SHAREPOINT_SITE_PATH="<site-name>"
